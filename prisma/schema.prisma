// ============================================================
// AUTH / NEXTAUTH
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  password      String?
  image         String?
  role          UserRole  @default(PATIENT)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts                 Account[]
  sessions                 Session[]
  patients                 Patient[]
  loginHistories           LoginHistory[]
  emailVerificationTokens  EmailVerificationToken[]
  twoFactorCodes             TwoFactorCode[]
  grantedShares            DataSharingPermission[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  success   Boolean
  timestamp DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@map("login_histories")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model Translation {
  id        String   @id @default(uuid())
  key       String
  language  String
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, language])
  @@index([category])
  @@map("translations")
}

model TwoFactorCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("two_factor_codes")
}

enum UserRole {
  ADMIN
  COORDINATOR
  PHYSICIAN
  NURSE
  PATIENT
  CAREGIVER
  DIALYSIS_STAFF
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  type      String   @default("string")  // string, boolean, number, json
  label     String?
  description String?
  category  String   @default("general") // general, email, notifications, security, maintenance
  editable  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([key])
  @@map("system_configs")
}

// ============================================================
// MEDICAL ENHANCEMENTS (5 features)
// ============================================================

// ── 3. Lab Values ──
model LabValue {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  testType    String   @map("test_type")     // eGFR, creatinine, hemoglobin, etc.
  value       Float
  unit        String   // e.g. "ml/min", "mg/dL", "g/dL"
  referenceLow  Float? @map("reference_low")
  referenceHigh Float? @map("reference_high")
  testedAt    DateTime @map("tested_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([testType])
  @@index([testedAt])
  @@map("lab_values")
}

// ── 4. Onboarding Steps ──
model PatientOnboarding {
  id          String            @id @default(uuid())
  patientId   String            @map("patient_id")
  stepKey     String            @map("step_key")   // consent, labs, hla, psych, first_appointment
  stepLabel   String            @map("step_label") // "Einwilligung", "Laborwerte", "HLA-Typisierung", etc.
  status      OnboardingStatus  @default(PENDING)
  dueDate     DateTime?         @map("due_date")
  completedAt DateTime?         @map("completed_at")
  completedBy String?           @map("completed_by")
  notes       String?
  sortOrder   Int               @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@index([sortOrder])
  @@map("patient_onboarding")
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ── 5. Cross-Team Comments ──
model PatientComment {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  authorRole String   @map("author_role")   // ADMIN, COORDINATOR, etc.
  content    String
  mentions   String[] // array of userIds mentioned with @
  isInternal Boolean  @default(true) @map("is_internal")
  parentId   String?  @map("parent_id")      // for threaded replies

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
  @@map("patient_comments")
}

// ── 2. Smart Reminders ──
model ReminderLog {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  requirementId String? @map("requirement_id")
  taskId      String?  @map("task_id")
  reminderType String  @map("reminder_type") // t30, t14, t7, t1, overdue, escalation
  sentAt      DateTime @default(now()) @map("sent_at")
  channel     String   // email, sms, push
  status      String   // sent, failed, bounced
  recipient   String?

  @@index([patientId])
  @@index([requirementId])
  @@index([sentAt])
  @@map("reminder_logs")
}
