// NephroAssist Prisma Schema
// Multi-tenant SaaS for Organ Transplant Coordination

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE IDENTITY & TENANCY
// ============================================================

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  type        OrganizationType
  logo        String?
  timezone    String             @default("Europe/Berlin")
  language    String             @default("de")
  contactInfo Json?              @map("contact_info")
  settings    Json?
  status      OrganizationStatus @default(ACTIVE)
  parentOrganizationId String?   @map("parent_organization_id")
  deletedAt            DateTime? @map("deleted_at")
  retentionUntil       DateTime? @map("retention_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent            Organization?         @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  children          Organization[]        @relation("OrganizationHierarchy")
  memberships       OrganizationMembership[]
  programs          TransplantProgram[]
  patients          Patient[]
  cases             PatientCase[]
  requirements      RequirementTemplate[]
  documents         Document[]
  appointments      Appointment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  featureFlags      FeatureFlag[]
  systemSettings    SystemSetting[]
  secureUploadLinks SecureUploadLink[]
  helpRequests      HelpRequest[]
  messages          Message[]
  Role              Role[]
  donorShares       DataSharingPermission[] @relation("DonorShares")
  receivedShares    DataSharingPermission[] @relation("RecipientShares")

  @@index([type])
  @@index([status])
  @@index([parentOrganizationId])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  roleId         String           @map("role_id")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  status         MembershipStatus @default(ACTIVE)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_memberships")
}

model Role {
  id             String       @id @default(uuid())
  name           String
  organizationId String?      @map("organization_id")
  isGlobal       Boolean      @default(false) @map("is_global")
  permissions    Permission[]

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization?            @relation(fields: [organizationId], references: [id])
  memberships  OrganizationMembership[]

  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  description String
  resource    String
  action      String

  roles Role[]

  @@index([resource])
  @@index([action])
  @@map("permissions")
}

// ============================================================
// PATIENT & CASE
// ============================================================

model Patient {
  id            String        @id @default(uuid())
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  dateOfBirth   DateTime      @map("date_of_birth")
  email         String?
  phone         String?

  // Hausarzt / Allgemeinarzt
  generalPractitionerName    String? @map("gp_name")
  generalPractitionerEmail   String? @map("gp_email")
  generalPractitionerPhone   String? @map("gp_phone")
  generalPractitionerAddress String? @map("gp_address")
  generalPractitionerCity    String? @map("gp_city")

  language      String        @default("de")
  timezone      String        @default("Europe/Berlin")
  consentStatus ConsentStatus @default(CONSENT_PENDING) @map("consent_status")
  userId        String?       @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")
  gdprConsentGrantedAt  DateTime? @map("gdpr_consent_granted_at")
  gdprConsentRevokedAt  DateTime? @map("gdpr_consent_revoked_at")
  gdprDataPortabilityAt DateTime? @map("gdpr_data_portability_at")

  // Relations
  cases           PatientCase[]
  documents       Document[]
  appointments    Appointment[]
  notifications   Notification[]
  caregiverAccess CaregiverAccess[]
  messages        Message[]
  helpRequests    HelpRequest[]
  medications     Medication[]
  dialysisRegimes DialysisRegime[]
  dataSharingPermissions DataSharingPermission[]
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  Organization    Organization?     @relation(fields: [organizationId], references: [id])
  organizationId  String?

  // ── NEW: Transplant Readiness Score ──
  readinessScore     Int?      @map("readiness_score")    // 0-100
  readinessScoreAt   DateTime? @map("readiness_score_at") // When last calculated

  // ── NEW: Waitlist tracking ──
  waitlistedDate     DateTime? @map("waitlisted_date")
  transplantType     String?   @map("transplant_type")   // kidney, liver, heart, lung, pancreas

  // ── NEW: Lab values, Onboarding, Comments ──
  labValues          LabValue[]
  onboardingSteps    PatientOnboarding[]
  comments           PatientComment[]

  @@index([email])
  @@index([consentStatus])
  @@index([userId])
  @@index([readinessScore])
  @@map("patients")
}

model Medication {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  name        String   // Medikamentenname (z.B. "Tacrolimus Sandoz")
  substance   String   // Wirkstoff (z.B. "Tacrolimus")
  dose        String   // Dosierung (z.B. "2mg", "500mg")
  morning     Boolean  @default(false)
  noon        Boolean  @default(false)
  evening     Boolean  @default(false)
  night       Boolean  @default(false)
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("medications")
}

model DialysisRegime {
  id                    String   @id @default(uuid())
  patientId             String   @map("patient_id")

  // Dialyseverfahren
  procedure             String   // Hämodialyse, Hämodiafiltration, Peritonealdialyse
  frequency             String   // z.B. "3-mal pro Woche", "täglich", "2-mal pro Woche"
  duration              String   // z.B. "4 Stunden", "5 Stunden", "8-10 Stunden (nächtlich)"

  // Gefäßzugang
  accessType            String   // AV-Fistel/Shunt, Dialysekatheter, Shaldon-Katheter, Peritonealdialyse-Katheter

  // Gewicht
  targetWeight            String?  @map("target_weight") // z.B. "72.5 kg"
  ultrafiltrationTarget   String?  @map("ultrafiltration_target") // z.B. "2.5-3.0 L"

  // Dialysegerät-Einstellungen
  bloodFlow             String?  @map("blood_flow") // z.B. "250-300 ml/min"
  dialysateFlow         String?  @map("dialysate_flow") // z.B. "500 ml/min"

  // Dialysator
  dialyzerType          String?  @map("dialyzer_type") // z.B. "High-Flux", "Low-Flux"
  dialyzerSize          String?  @map("dialyzer_size") // z.B. "1.8 m²", "2.1 m²"

  // Dialysatzusammensetzung
  potassium             String?  // z.B. "2.0 mmol/L", "3.0 mmol/L", "4.0 mmol/L"
  calcium               String?  // z.B. "1.25 mmol/L", "1.50 mmol/L", "1.75 mmol/L"
  sodium                String?  // z.B. "138 mmol/L", "140 mmol/L"
  bicarbonate           String?  // z.B. "32 mmol/L", "35 mmol/L"

  // Antikoagulation
  anticoagulation       String?  // z.B. "Heparin", "Citrat", "Keine", "Nadroparin"
  anticoagulationDose   String?  @map("anticoagulation_dose") // z.B. "5000 IE Bolus, 1000 IE/h"

  // Medikamente während Dialyse
  medicationsDuring     String?  @map("medications_during") // z.B. "Erythropoetin 4000 IE", "Eisensaccharat 200 mg"

  // Kontrollen
  monitoring            String?  // z.B. "Blutdruck alle 30 min", "Gewicht vor/nach", "Kt/V monatlich"

  // Labor-Kontrollen
  labControls           String?  @map("lab_controls") // z.B. "Phosphat, PTH, Hb, Ferritin monatlich"

  // Notizen
  notes                 String?

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdBy             String?  @map("created_by")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("dialysis_regimes")
}

model PatientCase {
  id                 String     @id @default(uuid())
  patientId          String     @map("patient_id")
  organizationId     String     @map("organization_id")
  programId          String     @map("program_id")
  coordinatorId      String?    @map("coordinator_id")
  status             CaseStatus @default(REFERRAL)
  referralDate       DateTime?  @map("referral_date")
  intakeDate         DateTime?  @map("intake_date")
  readyForReviewDate DateTime?  @map("ready_for_review_date")
  boardDecisionDate  DateTime?  @map("board_decision_date")
  waitlistedDate     DateTime?  @map("waitlisted_date")
  closedDate         DateTime?  @map("closed_date")
  closureReason      String?    @map("closure_reason")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id])
  program             TransplantProgram    @relation(fields: [programId], references: [id])
  requirements        PatientRequirement[]
  documents           Document[]
  appointments        Appointment[]
  blockers            Blocker[]
  helpRequests        HelpRequest[]
  timelineEvents      TimelineEvent[]
  transplantPassports TransplantPassport[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([coordinatorId])
  @@map("patient_cases")
}

// ============================================================
// TRANSPLANT PROGRAMS & REQUIREMENTS
// ============================================================

model TransplantProgram {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  slug           String
  description    String?
  type           ProgramType   @default(KIDNEY)
  status         ProgramStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates    RequirementTemplate[]
  cases        PatientCase[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("transplant_programs")
}

model TemplateSet {
  id          String    @id @default(uuid())
  name        String
  description String?
  items       Json?     // [{ name, category, required, description }]
  version     Int       @default(1)
  isLatest    Boolean   @default(true) @map("is_latest")
  parentId    String?   @map("parent_id")  // Verweis auf vorherige Version
  status      TemplateStatus @default(PUBLISHED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // Relation zu vorheriger Version
  parent TemplateSet? @relation("TemplateSetVersions", fields: [parentId], references: [id])
  versions TemplateSet[] @relation("TemplateSetVersions")

  @@index([name])
  @@index([isLatest])
  @@index([parentId])
  @@map("template_sets")
}

model RequirementTemplate {
  id                         String          @id @default(uuid())
  programId                  String          @map("program_id")
  organizationId             String          @map("organization_id")
  name                       String
  category                   String
  description                String?
  patientFriendlyDescription String?         @map("patient_friendly_description")
  required                   Boolean         @default(true)
  listingBlocker             Boolean         @default(false) @map("listing_blocker")
  conditional                Boolean         @default(false)
  validityDuration           Int?            @map("validity_duration") // in months
  renewalLeadTime            Int?            @map("renewal_lead_time") // in days
  responsibleRole            ResponsibleRole @default(PATIENT) @map("responsible_role")
  reviewRequired             Boolean         @default(true) @map("review_required")
  instructions               String?
  priority                   Int             @default(0)
  version                    Int             @default(1)
  status                     TemplateStatus  @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // Relations
  program             TransplantProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  organization        Organization                 @relation(fields: [organizationId], references: [id])
  versions            RequirementTemplateVersion[]
  patientRequirements PatientRequirement[]
  dependencies        RequirementDependency[]      @relation("TemplateDependencies")
  prerequisites       RequirementDependency[]      @relation("TemplatePrerequisites")

  @@index([programId])
  @@index([organizationId])
  @@index([status])
  @@map("requirement_templates")
}

model RequirementTemplateVersion {
  id          String    @id @default(uuid())
  templateId  String    @map("template_id")
  version     Int
  changes     String?
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")
  applyTo     ApplyTo   @default(NEW_ONLY) @map("apply_to")

  // Relations
  template RequirementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("requirement_template_versions")
}

model RequirementDependency {
  id             String @id @default(uuid())
  templateId     String @map("template_id")
  prerequisiteId String @map("prerequisite_id")

  // Relations
  template     RequirementTemplate @relation("TemplateDependencies", fields: [templateId], references: [id])
  prerequisite RequirementTemplate @relation("TemplatePrerequisites", fields: [prerequisiteId], references: [id])

  @@unique([templateId, prerequisiteId])
  @@index([templateId])
  @@index([prerequisiteId])
  @@map("requirement_dependencies")
}

model PatientRequirement {
  id                         String            @id @default(uuid())
  caseId                     String            @map("case_id")
  templateId                 String            @map("template_id")
  organizationId             String            @map("organization_id")
  programId                  String            @map("program_id")
  title                      String
  description                String?
  category                   String
  required                   Boolean           @default(true)
  listingBlocker             Boolean           @default(false) @map("listing_blocker")
  conditional                Boolean           @default(false)
  validityDuration           Int?              @map("validity_duration")
  renewalLeadTime            Int?              @map("renewal_lead_time")
  responsibleRole            ResponsibleRole   @default(PATIENT) @map("responsible_role")
  reviewRequired             Boolean           @default(true) @map("review_required")
  status                     RequirementStatus @default(NOT_STARTED)
  priority                   Int               @default(0)
  instructions               String?
  patientFriendlyDescription String?           @map("patient_friendly_description")
  dueDate                    DateTime?         @map("due_date")
  completedAt                DateTime?         @map("completed_at")
  expiresAt                  DateTime?         @map("expires_at")
  renewalStartedAt           DateTime?         @map("renewal_started_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  patientCase   PatientCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template      RequirementTemplate       @relation(fields: [templateId], references: [id])
  tasks         Task[]
  documentLinks DocumentRequirementLink[]
  blockers      Blocker[]
  appointments  Appointment[]
  helpRequests  HelpRequest[]

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
  @@index([expiresAt])
  @@index([listingBlocker, status])
  @@map("patient_requirements")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id            String     @id @default(uuid())
  requirementId String     @map("requirement_id")
  caseId        String     @map("case_id")
  patientId     String?    @map("patient_id")
  title         String
  description   String?
  ownerType     OwnerType  @default(PATIENT) @map("owner_type")
  ownerId       String?    @map("owner_id")
  status        TaskStatus @default(PENDING)
  dueDate       DateTime?  @map("due_date")
  completedAt   DateTime?  @map("completed_at")
  reminders     Json?
  dependencyOf  String?    @map("dependency_of")

  // Workflow step fields
  stepNumber      Int?     @map("step_number")
  stepName        String?  @map("step_name")
  stepDescription String?  @map("step_description")
  previousStepId  String?  @map("previous_step_id")
  isWorkflowStep  Boolean  @default(false) @map("is_workflow_step")

  // Completion tracking
  completedById   String?  @map("completed_by_id")
  completedByRole String?  @map("completed_by_role")

  // Flexible metadata for workflow steps (appointment data, upload info, etc.)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  requirement PatientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
  @@index([stepNumber])
  @@map("tasks")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id                String           @id @default(uuid())
  patientId         String           @map("patient_id")
  organizationId    String           @map("organization_id")
  caseId            String?          @map("case_id")
  fileKey           String           @map("file_key")
  filename          String
  mimeType          String           @map("mime_type")
  size              Int
  sha256            String
  documentType      String?          @map("document_type")
  documentDate      DateTime?        @map("document_date")
  uploadedBy        String           @map("uploaded_by")
  source            DocumentSource   @default(PATIENT_UPLOAD)
  processingStatus  ProcessingStatus @default(UPLOADED) @map("processing_status")
  classification    String?
  aiConfidence      Float?           @map("ai_confidence")
  ocrText           String?          @map("ocr_text")
  extractedData     Json?            @map("extracted_data")
  version           Int              @default(1)
  previousVersionId String?          @map("previous_version_id")
  kmsKeyId          String?          @map("kms_key_id")
  deletedAt         DateTime?        @map("deleted_at")
  retentionUntil    DateTime?        @map("retention_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  patient          Patient                   @relation(fields: [patientId], references: [id])
  organization     Organization              @relation(fields: [organizationId], references: [id])
  patientCase      PatientCase?              @relation(fields: [caseId], references: [id])
  previousVersion  Document?                 @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  versions         Document[]                @relation("DocumentVersions")
  reviews          DocumentReview[]
  requirementLinks DocumentRequirementLink[]
  extractedItems   ExtractedDocumentItem[]

  @@index([patientId])
  @@index([organizationId])
  @@index([caseId])
  @@index([processingStatus])
  @@index([sha256])
  @@index([documentDate])
  @@map("documents")
}

model DocumentRequirementLink {
  id            String     @id @default(uuid())
  documentId    String     @map("document_id")
  requirementId String     @map("requirement_id")
  matchedBy     MatchType  @default(MANUAL)
  confidence    Float?
  matchedAt     DateTime   @default(now()) @map("matched_at")
  matchedByUser String?    @map("matched_by_user")
  status        LinkStatus @default(ACTIVE)

  // Relations
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirement PatientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([documentId, requirementId])
  @@index([documentId])
  @@index([requirementId])
  @@map("document_requirement_links")
}

model ExtractedDocumentItem {
  id            String  @id @default(uuid())
  documentId    String  @map("document_id")
  itemType      String  @map("item_type")
  description   String?
  value         String?
  confidence    Float?
  requirementId String? @map("requirement_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extracted_document_items")
}

model DocumentReview {
  id              String       @id @default(uuid())
  documentId      String       @map("document_id")
  reviewerId      String       @map("reviewer_id")
  status          ReviewStatus
  rejectionReason String?      @map("rejection_reason")
  comment         String?
  reviewedAt      DateTime     @default(now()) @map("reviewed_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_reviews")
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                   String            @id @default(uuid())
  patientId            String            @map("patient_id")
  caseId               String?           @map("case_id")
  organizationId       String            @map("organization_id")
  type                 String
  provider             String?
  location             String?
  startTime            DateTime          @map("start_time")
  endTime              DateTime?         @map("end_time")
  status               AppointmentStatus @default(PLANNED)
  relatedRequirementId String?           @map("related_requirement_id")
  notes                String?
  reminders            Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  patient      Patient             @relation(fields: [patientId], references: [id])
  organization Organization        @relation(fields: [organizationId], references: [id])
  patientCase  PatientCase?        @relation(fields: [caseId], references: [id])
  requirement  PatientRequirement? @relation(fields: [relatedRequirementId], references: [id])

  @@index([patientId])
  @@index([caseId])
  @@index([organizationId])
  @@index([startTime])
  @@index([status])
  @@map("appointments")
}

// ============================================================
// BLOCKERS & HELP REQUESTS
// ============================================================

model Blocker {
  id            String        @id @default(uuid())
  caseId        String        @map("case_id")
  requirementId String?       @map("requirement_id")
  type          BlockerType
  description   String?
  status        BlockerStatus @default(ACTIVE)
  resolvedAt    DateTime?     @map("resolved_at")
  resolvedBy    String?       @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  patientCase PatientCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirement PatientRequirement? @relation(fields: [requirementId], references: [id])

  @@index([caseId])
  @@index([status])
  @@map("blockers")
}

model HelpRequest {
  id             String     @id @default(uuid())
  patientId      String     @map("patient_id")
  caseId         String     @map("case_id")
  organizationId String     @map("organization_id")
  requirementId  String?    @map("requirement_id")
  type           HelpType
  description    String?
  status         HelpStatus @default(OPEN)
  assignedTo     String?    @map("assigned_to")

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  deletedAt DateTime? @map("deleted_at")
  retentionUntil DateTime? @map("retention_until")

  // Relations
  patient      Patient             @relation(fields: [patientId], references: [id])
  patientCase  PatientCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])
  requirement  PatientRequirement? @relation(fields: [requirementId], references: [id])

  @@index([caseId])
  @@index([status])
  @@index([assignedTo])
  @@map("help_requests")
}

// ============================================================
// MESSAGING & NOTIFICATIONS
// ============================================================

model Message {
  id             String            @id @default(uuid())
  threadId       String            @map("thread_id")
  senderId       String            @map("sender_id")
  content        String
  entityType     MessageEntityType @map("entity_type")
  entityId       String            @map("entity_id")
  organizationId String            @map("organization_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  Patient      Patient?     @relation(fields: [patientId], references: [id])
  patientId    String?

  @@index([threadId])
  @@index([entityType, entityId])
  @@map("messages")
}

model Notification {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  type           NotificationType
  title          String
  message        String
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  read           Boolean          @default(false)
  readAt         DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  Patient      Patient?     @relation(fields: [patientId], references: [id])
  patientId    String?

  @@index([userId])
  @@index([read])
  @@index([organizationId])
  @@map("notifications")
}

// ============================================================
