  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([key, scope, organizationId])
  @@index([organizationId])
  @@map("system_settings")
}

// ============================================================
// AI CONFIGURATION
// ============================================================

model PromptTemplate {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  prompt      String
  version     Int          @default(1)
  status      PromptStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  promptVersions PromptVersion[]

  @@map("prompt_templates")
}

model PromptVersion {
  id          String    @id @default(uuid())
  templateId  String    @map("template_id")
  version     Int
  changes     String?
  prompt      String
  performance Json?
  usedAt      DateTime? @map("used_at")

  // Relations
  template PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("prompt_versions")
}

model AIProcessingLog {
  id            String  @id @default(uuid())
  documentId    String? @map("document_id")
  provider      String
  model         String
  promptVersion String? @map("prompt_version")
  inputHash     String  @map("input_hash")
  output        Json
  confidence    Float?
  humanOverride Boolean @default(false) @map("human_override")
  reviewerId    String? @map("reviewer_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@index([provider])
  @@map("ai_processing_logs")
}

// ============================================================
// DATA SHARING PERMISSIONS
// ============================================================

model DataSharingPermission {
  id                      String    @id @default(uuid())
  patientId               String    @map("patient_id")
  donorOrganizationId     String    @map("donor_organization_id")
  recipientOrganizationId String    @map("recipient_organization_id")
  resourceType            String    @map("resource_type")
  resourceId              String    @map("resource_id")
  grantedAt               DateTime  @default(now()) @map("granted_at")
  expiresAt               DateTime  @map("expires_at")
  revokedAt               DateTime? @map("revoked_at")
  grantedBy               String    @map("granted_by")

  // Relations
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  donorOrg      Organization  @relation("DonorShares", fields: [donorOrganizationId], references: [id], onDelete: Cascade)
  recipientOrg  Organization  @relation("RecipientShares", fields: [recipientOrganizationId], references: [id], onDelete: Cascade)
  grantedByUser User          @relation(fields: [grantedBy], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([recipientOrganizationId])
  @@index([expiresAt])
  @@map("data_sharing_permissions")
}

